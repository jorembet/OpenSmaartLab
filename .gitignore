# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# JUCE build output. Both an in-tree and a separate build directory are covered,
# since cmake can be run from JUCE/ as well as JUCE/build/.
JUCE/build/
JUCE/.cache/
JUCE/CMakeCache.txt
JUCE/CMakeFiles/
JUCE/CTestTestfile.cmake
JUCE/DartConfiguration.tcl
JUCE/Makefile
JUCE/cmake_install.cmake
JUCE/_deps/
JUCE/*_artefacts/
*.o
*.a

# Release artefacts. The packaged tarball and its notes are committed so they can be
# downloaded straight from the repository. The unpacked staging directory is not: it
# only duplicates what is inside the tarball.
dist/*/
dist/*.tar.gz.asc
dist/*.sig

# Local measurements and calibration downloads
99-*.csv
99-*.txt
*_snapshot*.csv

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
compile_commands.json